# ---------------------------------------------------------------------------
# Epineon — environment variables
#
# Copy to .env.local for development:   cp .env.example .env.local
# .env* is already git-ignored. Never commit real values.
#
# Anything named VITE_* is INLINED INTO THE PUBLIC BROWSER BUNDLE by Vite.
# Only put values here that are safe for anyone to read.
# ---------------------------------------------------------------------------

# --- Public (safe in the browser) ------------------------------------------
# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "anon" / publishable key. Public by design: every table it can reach
# is protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server only (NEVER prefixed VITE_) ------------------------------------
# Supabase "service_role" key. Bypasses Row Level Security — treat as a root
# password. Used only by the functions in api/. If this ever appears in a
# VITE_ variable, in src/, or in git, rotate it immediately in the Supabase
# dashboard (Project Settings → API → service_role → Reset).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same URL as above; kept separate so the server does not depend on a VITE_ var.
SUPABASE_URL=https://your-project-ref.supabase.co

# Random string used to hash IP addresses before they are counted or stored, so
# no raw address is ever written to the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=generate-a-long-random-string

# Absolute site URL used for invitation redirect links.
PUBLIC_SITE_URL=https://epineon.ai

# --- Optional ---------------------------------------------------------------
# Point the contact form at a different backend origin during development.
# Leave unset to use the same-origin /api/contact function.
# VITE_API_BASE_URL=
